# Environment variables for the PWA client
# Copy this file to .env.local and update the values

# Signaling Server WebSocket URL (your Raspberry Pi DDNS hostname)
VITE_SIGNALING_SERVER_URL=wss://your-hostname.duckdns.org

# STUN Server URL (for NAT traversal)
VITE_STUN_SERVER_URL=stun:your-hostname.duckdns.org:3478

# TURN credentials are obtained at runtime from the backend

