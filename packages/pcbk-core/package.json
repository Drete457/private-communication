{
  "name": "@private-communication/pcbk-core",
  "private": true,
  "version": "0.1.0",
  "description": "Core PCBK backup format primitives for Private Communication",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix"
  },
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "cbor-x": "^1.6.4",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "vitest": "^4.1.6"
  }
}
