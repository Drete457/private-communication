# Server environment variables
# Copy this file to .env and update the values

# Server Configuration
PORT=8080
NODE_ENV=development

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# Redis logical database index used by this backend instance.
REDIS_DB=0
# Enables Redis key expiration notifications so the backend can react to expired attachment keys.
REDIS_ENABLE_KEYSPACE_NOTIFICATIONS=true
# Required notification flags for expired key events consumed by the backend cleanup listener.
REDIS_KEYSPACE_EVENTS=Ex

# Message Queue Settings
MESSAGE_QUEUE_TTL=604800  # 7 days in seconds
RECEIPT_QUEUE_LIMIT=1000

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://your-hostname.duckdns.org,http://localhost:3000

# Logging
LOG_LEVEL=info

# HTTP body size limit (express.json)
HTTP_BODY_LIMIT=100kb

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# TURN REST credentials (ephemeral)
TURN_SECRET=your_turn_shared_secret
TURN_TTL_SECONDS=3600
TURN_URLS=turn:your-hostname.duckdns.org:3478?transport=udp,turn:your-hostname.duckdns.org:3478?transport=tcp,turns:your-hostname.duckdns.org:5349?transport=tcp

# HTTP signature auth for /api/preview and /api/push
# In production, keep HTTP_AUTH_DISABLED=false
HTTP_AUTH_DISABLED=true
HTTP_AUTH_WINDOW_MS=300000

# WebSocket security limits
WS_MAX_PAYLOAD_BYTES=262144
WS_MESSAGE_MAX_BYTES=262144
WS_RATE_LIMIT_WINDOW_MS=20000
WS_RATE_LIMIT_MAX=200
WS_AUTH_MAX=5
WS_MAX_CONNECTIONS_PER_IP=5
TRUST_PROXY_HOPS=1
WS_EVENT_MAX_DEFAULT=30
WS_EVENT_MAX_SEND_MESSAGE=20
WS_EVENT_MAX_SIGNAL=200
WS_EVENT_MAX_AUTH_RESPONSE=5
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=45000

# Call recovery
INCOMING_CALL_TTL_SECONDS=90
ACTIVE_CALL_SESSION_TTL_SECONDS=180
CALL_DISCONNECT_GRACE_MS=30000

# Attachments
ATTACHMENTS_ENABLED=true
# Writable storage path for attachment chunks. In Docker production this should point to the mounted attachment volume.
# If changed, also update the corresponding path in the docker-compose.yml
ATTACHMENTS_STORAGE_PATH=/data/attachments
ATTACHMENTS_TTL_SECONDS=604800
ATTACHMENTS_CLEANUP_SWEEP_ENABLED=true
ATTACHMENTS_CLEANUP_SWEEP_INTERVAL_MS=604800
ATTACHMENTS_CLEANUP_SWEEP_BATCH_SIZE=50
ATTACHMENTS_INIT_UPLOAD_RATE_LIMIT_WINDOW_MS=60000
ATTACHMENTS_INIT_UPLOAD_RATE_LIMIT_MAX=
ATTACHMENTS_CHUNK_RATE_LIMIT_WINDOW_MS=60000
ATTACHMENTS_CHUNK_RATE_LIMIT_MAX=500
ATTACHMENTS_MAX_CHUNK_BYTES=262144
ATTACHMENTS_MAX_FILE_MB=120
ATTACHMENTS_MAX_AUDIO_MB=10
ATTACHMENTS_MAX_IMAGE_MB=25
ATTACHMENTS_MAX_VIDEO_MB=120
ATTACHMENTS_MAX_DOCUMENT_MB=25
ATTACHMENTS_ALLOWED_AUDIO_MIME_TYPES=audio/
ATTACHMENTS_ALLOWED_IMAGE_MIME_TYPES=image/
ATTACHMENTS_ALLOWED_VIDEO_MIME_TYPES=video/
ATTACHMENTS_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,text/plain,text/csv,text/markdown,application/json,application/xml,text/xml,application/rtf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation
ATTACHMENTS_ALLOWED_FILE_MIME_TYPES=application/zip,application/x-zip-compressed,application/x-7z-compressed,application/x-rar-compressed,application/vnd.rar,application/gzip,application/x-tar
ATTACHMENTS_POLICY_VERSION=1

# Preview allowlist (comma-separated domains). Use * to allow all.
# Example: PREVIEW_ALLOWLIST=example.com,news.ycombinator.com
PREVIEW_ALLOWLIST=*
